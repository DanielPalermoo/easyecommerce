    "/api/auth/register": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Register a new user with shipping address",
        "description": "Creates a new user in the system including mandatory shipping information.\n\n📌 **Public Endpoint**\n\n✔ **Required fields**:\n- **name**: Full name\n- **email**: Valid and unique email\n- **password**: Minimum 6 characters\n- **street**: Street name and number\n- **city**: City (e.g., San Salvador de Jujuy)\n- **zipCode**: Postal code (e.g., 4600)\n\n✔ **Example**:\n{\n  \"name\": \"Fabrizio Armada\",\n  \"email\": \"fabri@test.com\",\n  \"password\": \"password123\",\n  \"street\": \"Alvear 1020\",\n  \"city\": \"San Salvador de Jujuy\",\n  \"zipCode\": \"4600\"\n}\n",
        "operationId": "registerUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "User registered successfully",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Validation error - Missing fields or invalid format",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
