{
  "openapi": "3.1.0",
  "info": {
    "title": "Easy E-commerce API",
    "description": "API for managing products, categories, and user authentication in an e-commerce application",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Order Resource",
      "description": "Endpoints for processing checkouts and managing customer orders.\n\n🚀 **Workflow**:\n- **Checkout**: Converts the current Cart into a finalized Order and **captures the user's shipping address**.\n- **Stock**: Automatically deducted during checkout.\n- **Shipping Details**: Every order stores a snapshot of the address (Street, City, ZipCode) to ensure delivery consistency.\n"
    },
    {
      "name": "Product Resource",
      "description": "Endpoints for managing products in the e-commerce system.\n\n🔐 Authentication required:\nYou must be logged in and provide a valid JWT token.\n\n📌 How to use:\n1. Login at /api/auth/login\n2. Copy the JWT token\n3. Click 'Authorize' in Swagger and paste: Bearer <your_token>\n\n⚠️ Permissions:\n- READ_ALL_PRODUCTS → view all products\n- READ_ONE_PRODUCT → view single product\n- SAVE_ONE_PRODUCT → create product (ADMIN only)\n- UPDATE_ONE_PRODUCT → update product (ADMIN only)\n- DELETE_ONE_PRODUCT → delete product (ADMIN only)\n\n📦 Product data includes:\n- Basic info (name, description, price, stock)\n- Category relationship\n- Active status (soft delete)\n"
    },
    {
      "name": "Authentication",
      "description": "Endpoints responsible for user registration, authentication, and session validation.\n\n🔐 **Authentication Flow**:\n1. Register with shipping details using `/register`\n2. Login using `/login`\n3. Use the JWT token in headers: `Authorization: Bearer <token>`\n\n👤 **Preloaded Users (from import.sql)**:\n- **ADMIN**: admin@test.com / admin123 (Location: Av. Fascio 123, San Salvador de Jujuy)\n- **USER**: user@test.com / user123 (Location: Belgrano 450, San Salvador de Jujuy)\n"
    },
    {
      "name": "Cart Resource",
      "description": "Endpoints for managing shopping carts in the e-commerce system.\n\n🔐 Authentication required:\nValid JWT token is mandatory for all operations.\n\n🛒 Cart Logic:\n- Each user has one unique cart.\n- Prices are captured at the moment an item is added.\n- Automatic cart creation is supported during retrieval.\n\n⚠️ Permissions:\n- READ_ONE_CART → view personal cart\n- SAVE_ONE_CART → initialize a cart for a specific user\n- ADD_ITEM_CART → add products to cart\n- UPDATE_QUANTITY_ITEM_CART → modify item quantities\n- DELETE_ITEM_CART → remove specific items\n- CLEAR_CART → empty the entire cart\n"
    },
    {
      "name": "Category Resource",
      "description": "Endpoints for managing product categories.\n\n🔐 Authentication required:\nYou must be logged in and provide a valid JWT token.\n\n📌 How to use:\n1. Login at /api/auth/login\n2. Copy the JWT token\n3. Click 'Authorize' in Swagger and paste: Bearer <your_token>\n\n⚠️ Permissions:\n- READ_ALL_CATEGORIES → view categories\n- SAVE_ONE_CATEGORY → create category\n- UPDATE_ONE_CATEGORY → update category\n- DELETE_ONE_CATEGORY → delete category\n"
    }
  ],
  "paths": {
    "/api/products/{id}": {
      "get": {
        "tags": [
          "Product Resource"
        ],
        "summary": "Get product by ID",
        "description": "Retrieve a specific product by its ID.\nRequires READ_ONE_PRODUCT permission.\n\n📋 Returns:\n- Complete product information\n- Category details\n- Stock and pricing info\n",
        "operationId": "getProductById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Product retrieved successfully",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponseDTO"
                }
              }
            }
          },
          "404": {
            "description": "Product not found",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponseDTO"
                }
              }
            }
          },
          "403": {
            "description": "Access denied (missing READ_ONE_PRODUCT permission)",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponseDTO"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "put": {
        "tags": [
          "Product Resource"
        ],
        "summary": "Update existing product",
        "description": "Update an existing product by its ID.\nRequires UPDATE_ONE_PRODUCT permission (ADMIN only).\n\n📝 Updatable fields:\n- name: Product name\n- description: Product description\n- price: Product price (must be positive)\n- stock: Available stock (minimum 0)\n- idCategory: Category ID (must exist)\n\n⚠️ Only administrators can update products.\nProduct must exist and be active.\n",
        "operationId": "updateProduct",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductRequestDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Product updated successfully",
            "content": {
              "*/*": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request data",
            "content": {
              "*/*": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Product or category not found",
            "content": {
              "*/*": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Access denied (ADMIN permission required)",
            "content": {
              "*/*": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Product Resource"
        ],
        "summary": "Delete product (soft delete)",
        "description": "Soft delete a product by setting active = false.\nRequires DELETE_ONE_PRODUCT permission (ADMIN only).\n\n⚠️ Important notes:\n- This performs a SOFT DELETE (product becomes inactive)\n- Product data is preserved for audit purposes\n- Product won't appear in regular listings\n- Only administrators can delete products\n",
        "operationId": "deleteProduct",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Product deleted successfully (soft delete)"
          },
          "404": {
            "description": "Product not found"
          },
          "403": {
            "description": "Access denied (ADMIN permission required)"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
