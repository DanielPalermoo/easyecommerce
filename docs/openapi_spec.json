                  "$ref": "#/components/schemas/UserDTO"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/categories/{id}": {
      "delete": {
        "tags": [
          "Category Resource"
        ],
        "summary": "Delete category",
        "description": "Delete a category by ID. Requires DELETE_ONE_CATEGORY permission",
