# --- APP ---
APP_PORT=8081
FRONT_PORT=8082
SQL_INIT_MODE=always

# --- POSTGRESQL ---
POSTGRES_DB=easyecommerce
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_esto
DB_PORT=5433

# --- POSTGRESQL HA CLUSTER ---
DB_APP_USER=app_user
DB_APP_PASSWORD=cambiar_esto
DB_BACKUP_USER=backup_user
DB_BACKUP_PASSWORD=cambiar_esto

# --- PGADMIN ---
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@easycommerce.com
PGADMIN_PASSWORD=cambiar_esto

# --- N8N ---
DB_PORT=5433
N8N_VERSION=2.42.7   # mirar hub.docker.com/r/n8nio/n8n
N8N_HOST=localhost
N8N_PUBLIC_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=cambiar_por_clave_larga_aleatoria

# --- BACKUP ---
BACKUP_TOKEN=cambiar_por_token_largo_aleatorio

# --- MANTISBT ---
MANTIS_DB_NAME=bugtracker
MANTIS_DB_USER=mantisbt
MANTIS_DB_PASSWORD=cambiar_esto
MANTIS_VERSION=2.27.0
MANTIS_PORT=8083

# --- PROMETHEUS / GRAFANA ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=cambiar_esto

# --- TUNEL (solo para el deploy) ---
CLOUDFLARED_VERSION=poner_version_fija
TUNNEL_TOKEN=

# --- DESPLIEGUE CONTINUO (WATCHTOWER + GHCR) ---
# Imagenes publicadas por el CI/CD. IMAGE_TAG = rama que se despliega (develop o main)
GHCR_IMAGE_PREFIX=ghcr.io/danielpalermoo/easyecommerce
IMAGE_TAG=develop
WATCHTOWER_VERSION=1.24.1
WATCHTOWER_POLL_INTERVAL=60
WATCHTOWER_PORT=8084
# Token de la API HTTP (el mismo valor va en el secret WATCHTOWER_HTTP_API_TOKEN de GitHub)
WATCHTOWER_HTTP_API_TOKEN=cambiar_por_token_largo_aleatorio
# Solo si los paquetes de GHCR son privados: usuario de GitHub + PAT con scope read:packages
GHCR_USER=
GHCR_TOKEN=

# --- ZONA HORARIA ---
TZ=America/Argentina/Jujuy
GENERIC_TIMEZONE=America/Argentina/Jujuy

# --- CREDENCIALES NEXT CLOUD---
DB_PASSWORD=CAMBIAR_PASSWORD_BD_LARGO_Y_ALEATORIO
NC_ADMIN_USER=admin_doc
NC_ADMIN_PASSWORD=CAMBIAR_PASSWORD_ADMIN_LARGO_Y_ALEATORIO
